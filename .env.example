# Local: copy to .env.local.   Production: add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Quote form emails (required) ---
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@rainhubsolutions.co.za
QUOTE_FROM_EMAIL="Rain Hub <quotes@your-verified-domain.co.za>"

# --- Bot check (optional; both must be set to switch it on) ---
# Free at dash.cloudflare.com → Turnstile. Site key is public, secret stays on the server.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Site address (optional) ---
# Overrides "siteUrl" in shared/site.json when building the sitemap and share tags.
SITE_URL=
